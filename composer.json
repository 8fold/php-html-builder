{
  "name": "8fold/php-html-builder",
  "description": "A library for building HTML document and element strings.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Josh Bruce",
      "email": "josh@8fold.pro"
    }
  ],
  "require": {
    "php": "^8.4"
  },
  "require-dev": {
    "phpstan/extension-installer": "*",
    "phpstan/phpstan": "^2.3",
    "phpstan/phpstan-strict-rules": "^2.1",
    "phpunit/phpunit": "^13.4",
    "spaze/phpstan-disallowed-calls": "^4.15",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Eightfold\\HtmlBuilder\\": "./src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Eightfold\\HtmlBuilder\\Tests\\": "./tests"
    }
  },
  "config": {
    "preferred-install": "dist",
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "prefer-stable": true,
  "scripts": {
    "prod": "@check",
    "production": "@check",
    "check": [
      "@check:style",
      "@check:analysis",
      "@check:test"
    ],
    "check:style": "./vendor/bin/phpcs --standard=phpcs.xml -p ./src",
    "check:analysis": "./vendor/bin/phpstan analyze",
    "check:test": "./vendor/bin/phpunit --display-all-issues"
  }
}
